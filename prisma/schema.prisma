// Prisma Schema for Mobile Engineering Portfolio Application
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Environment Setup:
// Local Development: provider = "sqlite" (DATABASE_URL="file:./dev.db")
// Production: provider = "mysql" (DATABASE_URL="mysql://user:pass@host:3306/db")
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Platform {
  IOS
  ANDROID
  CROSS_PLATFORM
}

enum ProjectStatus {
  COMPLETED
  IN_DEVELOPMENT
  MAINTENANCE
  ARCHIVED
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model Profile {
  id               String   @id @default(uuid())
  name             String
  headline         String
  bio              String
  avatarUrl        String?
  location         String
  yearsExperience  Int
  appsPublished    Int
  totalDownloads   Int      @default(0)
  githubUrl        String?
  linkedinUrl      String?
  twitterUrl       String?
  email            String
  availableForHire Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id              String          @id @default(uuid())
  slug            String          @unique
  title           String
  tagline         String
  description     String
  longDescription String?
  platform        Platform        @default(CROSS_PLATFORM)
  status          ProjectStatus   @default(COMPLETED)
  featured        Boolean         @default(false)
  featuredOrder   Int             @default(0)
  coverImageUrl   String?
  architecture    String?
  appStoreUrl     String?
  playStoreUrl    String?
  githubUrl       String?
  demoUrl         String?
  downloadsCount  Int             @default(0)
  rating          Float           @default(5.0)
  testCoverage    Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  features        ProjectFeature[]
  assets          ProjectAsset[]
  skills          ProjectSkill[]
}

model ProjectFeature {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAsset {
  id          String   @id @default(uuid())
  projectId   String
  url         String
  caption     String?
  type        String   @default("IMAGE") // IMAGE, VIDEO
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SkillCategory {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  skills    Skill[]
}

model Skill {
  id          String        @id @default(uuid())
  categoryId  String
  name        String
  proficiency Int           // 1 to 100
  yearsOfExp  Float?
  iconUrl     String?
  featured    Boolean       @default(false)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())

  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  projects    ProjectSkill[]
}

model ProjectSkill {
  projectId String
  skillId   String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model WorkExperience {
  id             String   @id @default(uuid())
  company        String
  companyLogoUrl String?
  role           String
  employmentType String   @default("FULL_TIME") // FULL_TIME, CONTRACT, FREELANCE
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean  @default(false)
  description    String
  achievements   String   // JSON formatted array of achievements
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id          String        @id @default(uuid())
  senderName  String
  senderEmail String
  subject     String
  message     String
  status      MessageStatus @default(UNREAD)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
